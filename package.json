{
  "name": "intraai",
  "version": "1.0.0",
  "description": "IntraAI Workspace",
  "main": "index.js",
  "scripts": {
    "infra": "docker compose up -d",
    "ai": "cd ai-service && python main.py",
    "backend": "npm --prefix backend run dev",
    "worker": "npm --prefix worker run dev",
    "frontend": "npm --prefix frontend run dev",
    "dev": " npx concurrently -k -n \"ai,backend,worker,frontend\" -c \"magenta,yellow,green,cyan\" \"npm run ai\" \"npm run backend\" \"npm run worker\" \"npm run frontend\"",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/multer": "^2.1.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@eslint/js": "^10.0.1"
  }
}